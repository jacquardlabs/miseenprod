{{!< default}}

{{#post}}
<main class="article">
    <div class="container">
        <header class="article-header">
            <div class="article-flag">
                {{#if featured}}
                    <span class="glyph g-signal">&#9733;</span>
                {{else}}
                    <span class="glyph g-note">&bull;</span>
                {{/if}}
                {{#primary_tag}}<a href="{{url}}">{{name}}</a>{{else}}Entry{{/primary_tag}}
            </div>

            <h1 class="article-title">{{title}}</h1>

            <div class="article-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
                {{#if reading_time}}
                    <span>&middot;</span>
                    <span>{{reading_time minute="1 min read" minutes="% min read"}}</span>
                {{/if}}
            </div>
        </header>

        <section class="article-content">
            {{content}}
        </section>

        {{#if tags}}
            <div class="article-tags">
                {{tags separator=", " autolink="true"}}
            </div>
        {{/if}}

        {{!-- Threading: previous/next entries connect the log --}}
        <nav class="post-nav">
            {{#prev_post}}
                <div class="post-nav-item prev">
                    <span class="post-nav-label">&larr; previous entry</span>
                    <a class="post-nav-title" href="{{url}}">{{title}}</a>
                </div>
            {{else}}
                <div class="post-nav-item prev"></div>
            {{/prev_post}}
            {{#next_post}}
                <div class="post-nav-item next">
                    <span class="post-nav-label">next entry &rarr;</span>
                    <a class="post-nav-title" href="{{url}}">{{title}}</a>
                </div>
            {{else}}
                <div class="post-nav-item next"></div>
            {{/next_post}}
        </nav>
    </div>
</main>
{{/post}}
