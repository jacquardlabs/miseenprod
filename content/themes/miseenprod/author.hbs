{{!< default}}

<main>
    <div class="container">
        {{#author}}
            <header class="author-header">
                <h1 class="author-header-name">{{name}}</h1>
                {{#if bio}}
                    <p class="author-header-bio">{{bio}}</p>
                {{/if}}
            </header>
        {{/author}}

        <section class="index">
            {{#foreach posts}}
                {{> post-card pageno=@number}}
            {{/foreach}}
        </section>

        {{#if pagination.next}}
            <nav class="pagination">
                {{#if pagination.prev}}<a href="{{pagination.prev}}">&larr; Newer</a>{{else}}<span></span>{{/if}}
                <span class="page-number">p. {{pagination.page}} / {{pagination.pages}}</span>
                <a href="{{pagination.next}}">Older &rarr;</a>
            </nav>
        {{else if pagination.prev}}
            <nav class="pagination">
                <a href="{{pagination.prev}}">&larr; Newer</a>
                <span class="page-number">p. {{pagination.page}} / {{pagination.pages}}</span>
                <span></span>
            </nav>
        {{/if}}
    </div>
</main>
