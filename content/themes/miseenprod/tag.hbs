{{!< default}}

<main>
    <div class="container">
        {{#tag}}
            <header class="tag-header">
                <h1 class="tag-header-name">{{name}}</h1>
                {{#if description}}
                    <p class="tag-header-description">{{description}}</p>
                {{/if}}
                <p class="tag-header-count">
                    {{plural ../pagination.total empty="No entries" singular="1 entry" plural="% entries"}}
                </p>
            </header>
        {{/tag}}

        <section class="index">
            {{#foreach posts}}
                {{> post-card pageno=@number}}
            {{/foreach}}
        </section>

        {{#if pagination.next}}
            <nav class="pagination">
                {{#if pagination.prev}}<a href="{{pagination.prev}}">&larr; Newer</a>{{else}}<span></span>{{/if}}
                <span class="page-number">p. {{pagination.page}} / {{pagination.pages}}</span>
                <a href="{{pagination.next}}">Older &rarr;</a>
            </nav>
        {{else if pagination.prev}}
            <nav class="pagination">
                <a href="{{pagination.prev}}">&larr; Newer</a>
                <span class="page-number">p. {{pagination.page}} / {{pagination.pages}}</span>
                <span></span>
            </nav>
        {{/if}}
    </div>
</main>
